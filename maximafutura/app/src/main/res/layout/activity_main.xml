<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.akhilmulpuri.maximafutura.HudFrameView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="34dp">

        <!-- Tabs, centred on a hairline. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="20dp"
                android:layout_weight="1"
                android:background="#2850FF96" />

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabNet"
                    style="@style/Tab" />

                <TextView
                    android:id="@+id/tabSettings"
                    style="@style/Tab"
                    android:layout_marginStart="12dp"
                    android:text="SETTINGS" />

                <TextView
                    android:id="@+id/tabInputs"
                    style="@style/Tab"
                    android:layout_marginStart="12dp"
                    android:text="INPUTS"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="#2850FF96" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Clock left, selected app right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextClock
                        style="@style/Ox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-3dp"
                        android:fontVariationSettings="'wght' 200"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="@color/text"
                        android:textSize="100sp" />

                    <TextClock
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="14dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="@color/green" />
                </LinearLayout>

                <TextView
                    android:id="@+id/date"
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.28"
                    android:textSize="13sp" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/green" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:letterSpacing="0.4"
                    android:text="NOW SELECTED"
                    android:textColor="@color/green" />

                <TextView
                    android:id="@+id/target"
                    style="@style/Ox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontVariationSettings="'wght' 300"
                    android:gravity="end"
                    android:textColor="@color/text"
                    android:textSize="58sp" />

                <TextView
                    android:id="@+id/meta"
                    style="@style/Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:letterSpacing="0.2"
                    android:textSize="12sp" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/green" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- App rail. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginStart="-48dp"
            android:layout_marginEnd="-48dp"
            android:clipChildren="false">

            <HorizontalScrollView
                android:id="@+id/railScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="34dp"
                android:paddingEnd="34dp"
                android:scrollbars="none">

                <!-- Inner padding leaves room for the focused tile's scale and glow. -->
                <LinearLayout
                    android:id="@+id/rail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:padding="14dp"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <view
                android:id="@+id/fade"
                class="com.akhilmulpuri.maximafutura.HudFrameView$Fade"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_gravity="end" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
