<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="26dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Header: date left; inputs, network and settings right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/date"
            style="@style/Nerd.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnInputs"
            style="@style/Nerd.Small"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnNet"
            style="@style/Nerd.Small"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/Nerd.Small"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="-10dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true" />
    </LinearLayout>

    <View style="@style/Nerd.Line" android:layout_marginTop="8dp" />

    <!-- Status badge. -->
    <TextView
        android:id="@+id/badge"
        style="@style/Nerd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@color/yellow"
        android:letterSpacing="0.1"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp"
        android:textColor="#FF141414"
        android:textSize="14sp" />

    <!-- Hero: big clock, its side notes, and the stats table. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock"
            style="@style/Nerd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text"
            android:textSize="118sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/ampm"
                style="@style/Nerd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="a"
                android:format24Hour=""
                android:letterSpacing="0.1"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/dateLong"
                style="@style/Nerd.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/dim" />

            <TextView
                android:id="@+id/week"
                style="@style/Nerd.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/dim" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TableLayout
            android:id="@+id/stats"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:stretchColumns="1" />
    </LinearLayout>

    <View style="@style/Nerd.Line" android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/info"
        style="@style/Nerd.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="13dp"
        android:paddingBottom="13dp" />

    <View style="@style/Nerd.Line" />

    <!-- Apps: dock row, then the rest. Built in code. -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
